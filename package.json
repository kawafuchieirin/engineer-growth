{
  "name": "engineer-growth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "エンジニアとしてのスキル可視化・目標策定・ロードマップ・ブログを一元管理するリポジトリ",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "growth": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate",
    "build": "tsx src/cli.ts build",
    "new:post": "tsx src/cli.ts new-post",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && pnpm run validate",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run validate && pnpm run build"
  },
  "dependencies": {
    "marked": "15.0.6",
    "yaml": "2.9.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^7",
    "vitest": "5.0.4"
  }
}
